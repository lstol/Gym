# Public — bundled into the client. Anything prefixed VITE_ is visible to anyone
# who opens the app. Safe here because Postgres access is gated by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Everything else — service role key, STRAVA_CLIENT_SECRET — is an Edge Function
# secret, never a VITE_ var, and never lives in this file. Set those with:
#   supabase secrets set STRAVA_CLIENT_SECRET=...
